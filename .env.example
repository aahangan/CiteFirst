# Long random string that signs login cookies and links: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the site, e.g. https://getcitefirst.com (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=

# Required: free U.S. Department of Labor API key for OSHA data (https://dataportal.dol.gov/registration, then API keys)
DOL_API_KEY=

# Stripe: product "CiteFirst Pro" with two monthly prices
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASE=        # $149/month
STRIPE_PRICE_AREA_LOCK=   # $99/month (quantity = number of exclusive states)
STRIPE_WEBHOOK_SECRET=    # from the webhook endpoint you create for /api/stripe/webhook

# Upstash Redis (Vercel Marketplace sets these automatically; KV_REST_API_* names also work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: login links and the 7am case email. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="CiteFirst <alerts@yourdomain.com>"

# Anthropic: AI-drafted letters, emails and call openers
ANTHROPIC_API_KEY=
# Model id for outreach drafting, e.g. claude-sonnet-5-5
AI_MODEL=

# Protects the daily job. Vercel sends it automatically to cron routes.
CRON_SECRET=

# Shown on privacy/terms
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin: emails that can open /admin and receive alerts (comma-separated), and a secret for scripts/backfill
ADMIN_EMAILS=
ADMIN_REPLY_TO=
ADMIN_SECRET=
